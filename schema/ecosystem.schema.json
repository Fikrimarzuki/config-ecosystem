{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config-ecosystem.invalid/schema/ecosystem.schema.json",
  "title": "Ecosystem Config",
  "description": "Structural contract for the ecosystem project and deployment registry. Cross-project rules (unique hostnames, unique deployment names, meaningful strings) are enforced by scripts/validate.mjs.",
  "type": "object",
  "required": ["version", "username", "domains", "projects"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Config contract version.",
      "const": 1
    },
    "username": {
      "description": "GitHub username that owns the repositories.",
      "$ref": "project.schema.json#/$defs/nonEmptyString"
    },
    "domains": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/domain" }
      }
    },
    "profile": {
      "description": "Personal profile of the owner. Optional; additive to the top-level fields.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Display name of the owner.",
          "$ref": "project.schema.json#/$defs/nonEmptyString"
        },
        "links": {
          "description": "Canonical social links keyed by platform (e.g. github, linkedin, website). Any key is allowed; values must be absolute HTTPS URLs.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "project.schema.json#/$defs/key" },
          "additionalProperties": { "$ref": "project.schema.json#/$defs/httpsUrl" }
        }
      }
    },
    "ecosystem": {
      "description": "Shared ecosystem brand identity, separate from the personal profile. Optional.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Ecosystem brand name.",
          "$ref": "project.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "projects": {
      "type": "object",
      "propertyNames": { "$ref": "project.schema.json#/$defs/key" },
      "additionalProperties": {
        "type": "object",
        "$ref": "project.schema.json#/$defs/project",
        "unevaluatedProperties": false
      }
    }
  },
  "$defs": {
    "domain": {
      "description": "must be a lowercase domain with at least two DNS labels, e.g. example.com",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    }
  }
}
